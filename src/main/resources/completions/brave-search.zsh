  local cmds8=(spellcheck)
  local cmds9=(places)
  local cmds10=(rich)
  local cmds11=(answers)
  local cmds12=(completion)
  local cmds13=(config set-key)
  local cmds14=(config unset-key)
  local cmds15=(config show)
