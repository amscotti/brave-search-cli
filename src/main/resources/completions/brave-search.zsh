  if CompWordsContainsArray "${cmds13[@]}"; then _picocli_brave-search_config_setkey; return $?; fi
  if CompWordsContainsArray "${cmds12[@]}"; then _picocli_brave-search_completion; return $?; fi
  if CompWordsContainsArray "${cmds11[@]}"; then _picocli_brave-search_answers; return $?; fi
  if CompWordsContainsArray "${cmds10[@]}"; then _picocli_brave-search_rich; return $?; fi
  if CompWordsContainsArray "${cmds9[@]}"; then _picocli_brave-search_places; return $?; fi
  if CompWordsContainsArray "${cmds8[@]}"; then _picocli_brave-search_spellcheck; return $?; fi
