# Generates completions for the options and subcommands of the `brave-search` command.
function _picocli_brave-search() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}

  local commands="version config web context news videos images suggest spellcheck places rich answers completion"
  local flag_opts="'--help' '--no-color' '--quiet' '--verbose' '--version' '-V' '-h'"
  local arg_opts=""

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

