  local cmds18=(places details)
  local cmds19=(places describe)

  if CompWordsContainsArray "${cmds19[@]}"; then _picocli_brave-search_places_describe; return $?; fi
  if CompWordsContainsArray "${cmds18[@]}"; then _picocli_brave-search_places_details; return $?; fi
